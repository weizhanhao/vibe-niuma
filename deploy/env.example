# doskill ECS 部署环境变量样板。
# 复制成 .env 填好，再跑 deploy.sh。所有秘密都从这里注入，不进 git。

# ── ECS 与基础 ────────────────────────────────────────────────────
ECS_USER=root
ECS_HOST=                             # ECS 公网 IP 或域名
ECS_SSH_KEY=~/.ssh/id_ed25519         # 本地 SSH 私钥路径
DEPLOY_ROOT=/opt/doskill               # ECS 上的根目录

# ── Orchestrator ─────────────────────────────────────────────────
ORCHESTRATOR_PORT=9000
DATABASE_URL=mysql+pymysql://root:demopass@127.0.0.1:3306/orchestrator
DEMO_REPO_PATH=/opt/doskill/demo
QUOTA_SIZE=5                           # 按 ECS 内存定：每个预览容器约 ~512MB
IDLE_TTL_SECONDS=1800
REAPER_INTERVAL_SECONDS=60
PREVIEW_HOST=                          # ECS 公网 IP/域名（拼预览 URL）
PREVIEW_PORT_MIN=5100
PREVIEW_PORT_MAX=5199
DOCKER_NETWORK=bridge

# ── Dev runner / 模型 ────────────────────────────────────────────
DEV_RUNNER=claude-code                 # claude-code | opencode
DEV_MODEL=deepseek-chat
ANTHROPIC_BASE_URL=http://127.0.0.1:8787   # 本机 Anthropic-compatible 代理
LLM_API_KEY=                           # 必填：dev runner + 澄清共用
VISION_MODEL=qwen-vl-plus
DEV_RUNNER_TIMEOUT_SECONDS=900

# ── MySQL（root 密码 + 库名）────────────────────────────────────────
MYSQL_ROOT_PASSWORD=demopass
MYSQL_PORT=3306

# ── LLM proxy ────────────────────────────────────────────────────
LLM_PROXY_PORT=8787
LLM_PROXY_KIND=litellm                 # litellm | claude-code-router | one-api

# ── 镜像与 git 托管 ──────────────────────────────────────────────
USE_NPM_MIRROR=1                       # 1 = npmmirror；0 = 官方源
USE_PIP_MIRROR=1                       # 1 = 清华 pypi；0 = 官方
DEMO_GIT_REMOTE=                       # 留空 = rsync + 本地 git init；填 git URL = clone
