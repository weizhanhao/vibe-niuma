# doskill ECS 部署环境变量样板。
# 复制成 .env 填好，再跑 deploy.sh。所有秘密都从这里注入，不进 git。
#
# ⚠ 警告：systemd 的 EnvironmentFile 不剥行内 `#` 注释 —— 注释必须独占一行。
#         别写 `KEY=value  # 说明`，会让 value 变成 `value  # 说明` 字面量，
#         传给 opencode / docker 等子进程时会神秘失败（rc=1 空 stderr）。

# ── ECS 与基础 ────────────────────────────────────────────────────
ECS_USER=root
# ECS 公网 IP 或域名
ECS_HOST=
# 本地 SSH 私钥路径
ECS_SSH_KEY=~/.ssh/id_ed25519
# ECS 上的根目录
DEPLOY_ROOT=/opt/doskill

# ── Orchestrator ─────────────────────────────────────────────────
ORCHESTRATOR_PORT=9000
DATABASE_URL=mysql+pymysql://root:demopass@127.0.0.1:3306/orchestrator
DEMO_REPO_PATH=/opt/doskill/demo
# 按 ECS 内存定：每个预览容器约 ~512MB
QUOTA_SIZE=5
IDLE_TTL_SECONDS=1800
REAPER_INTERVAL_SECONDS=60
# ECS 公网 IP/域名（拼预览 URL）
PREVIEW_HOST=
PREVIEW_PORT_MIN=5100
PREVIEW_PORT_MAX=5199
# 预览容器加入 main-demo 网络，能按容器名解析到 doskill-demo-backend
DOCKER_NETWORK=doskill-net
# 预览容器 vite proxy /api → 这个 URL。空串则预览没数据。
PREVIEW_BACKEND_URL=http://doskill-demo-backend:8000
# 合并成功后跑这个脚本（异步）重建 main-demo。空串则跳过（本地开发用）
MAIN_DEMO_REFRESH_SCRIPT=/opt/doskill/deploy/main-demo.sh

# ── Dev runner / 模型 ────────────────────────────────────────────
# claude-code: Anthropic 官方 CLI，要走 LiteLLM 当 Anthropic-compatible 代理；
#              但与 DeepSeek hybrid thinking mode 协议不兼容（reasoning_content
#              必须回传），调用 deepseek-* 系列会被 400 拒。
# opencode:    sst.dev 的开源 CLI，直连 provider；模型名要带 provider 前缀
#              如 `deepseek/deepseek-v4-flash`、`anthropic/claude-sonnet-4-5`。
DEV_RUNNER=opencode
# opencode 要 provider/model；DeepSeek 已废 v3，只剩 v4-flash / v4-pro
DEV_MODEL=deepseek/deepseek-v4-flash
# 本机 Anthropic-compatible 代理（claude-code 用；opencode 不需要）
ANTHROPIC_BASE_URL=http://127.0.0.1:8787
# 必填：claude-code → LiteLLM 的 token；澄清（BrainstormingSkill）共用
LLM_API_KEY=
VISION_MODEL=qwen-vl-plus
DEV_RUNNER_TIMEOUT_SECONDS=900

# ── MySQL（root 密码 + 库名）────────────────────────────────────────
MYSQL_ROOT_PASSWORD=demopass
MYSQL_PORT=3306

# ── LLM proxy ────────────────────────────────────────────────────
LLM_PROXY_PORT=8787
# litellm | claude-code-router | one-api
LLM_PROXY_KIND=litellm

# ── 镜像与 git 托管 ──────────────────────────────────────────────
# 1 = npmmirror；0 = 官方源
USE_NPM_MIRROR=1
# 1 = 清华 pypi；0 = 官方
USE_PIP_MIRROR=1
# 1 = 配 daocloud/163 镜像加速；0 = 直连 Docker Hub
USE_DOCKER_MIRROR=1
# 留空 = rsync + 本地 git init；填 git URL = clone
DEMO_GIT_REMOTE=

# ── main demo 站（业务员框选的「样板间」/ A 方案）─────────────────
# 由 deploy/main-demo.sh 起：doskill-demo-backend + doskill-demo-frontend
# 接到 doskill-net 上、走宿主 mysql 的 'demo' schema。
# 复用 5100-5199 范围（已在 SG 中）；不与 preview adapter 冲突（quota 远小于 100）
MAIN_DEMO_FRONTEND_PORT=5199
# mysql schema 名
MAIN_DEMO_DB=demo
