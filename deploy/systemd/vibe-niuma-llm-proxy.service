[Unit]
Description=vibe-niuma LiteLLM proxy (Anthropic / OpenAI compatible)
After=network-online.target
Wants=network-online.target
# Plan 11 M3.T20：30 分钟内最多 10 次重启
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/opt/vibe-niuma/.env
Environment=STORE_MODEL_IN_DB=False
WorkingDirectory=/opt/vibe-niuma/llm-proxy
# env -u 显式剔除 DATABASE_URL（orchestrator 用的，被 EnvironmentFile 串进来了，
# LiteLLM 看到就以为要起 prisma DB）
ExecStart=/usr/bin/env -u DATABASE_URL /opt/vibe-niuma/llm-proxy/venv/bin/litellm \
  --config /opt/vibe-niuma/llm-proxy/config.yml \
  --port ${LLM_PROXY_PORT}
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
