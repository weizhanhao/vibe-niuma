# Plan 11 M4.T29 —— Caddy 反向代理 + 自动 HTTPS
#
# 业务员的扩展走 HTTPS 调 orchestrator —— Chrome 拒绝 http 跨域到 extension://；
# sslip.io 给 ECS 公网 IP 自动配成域名，Caddy 找 Let's Encrypt 申免费证书。
#
# 用法：
#   1. ecs-bootstrap.sh 装好 Caddy（apt install caddy）
#   2. cp deploy/Caddyfile /etc/caddy/Caddyfile（替 $PUBLIC_HOST 占位符）
#   3. systemctl enable --now caddy
#   4. Caddy 自动从 :443 监听 + 找 ACME 证书 + 反向代理到 :9000
#
# 业务员粘 https://1-2-3-4.sslip.io 到扩展即可（不用记 IP）。

# 全局：给 ACME 用的 email（ZeroSSL 必须，LE 也欢迎）。
# 加 ZeroSSL fallback —— sslip.io 在 Let's Encrypt 上 sliding window 永远满
# （250k cert / 168h），单一 LE 拿不到证书；ZeroSSL 独立配额池，少撞墙。
{
	email vibe-niuma@local
}

# Public host 占位：ecs-bootstrap.sh 用 sed 替成 e.g. 1-2-3-4.sslip.io
{$PUBLIC_HOST} {
	# 自动 ACME：上面全局 email 让 Caddy 默认 issuer 链跑「LE → ZeroSSL」
	# 任何一家给证书就成。sslip.io 在 LE 长期撞配额，靠 ZeroSSL 兜底。

	# Orchestrator REST + SSE
	# Caddy 默认 60s timeout 会断 SSE，长流式调到 30 分钟
	reverse_proxy /change-requests/*/stream localhost:9000 {
		flush_interval -1
		transport http {
			read_timeout 30m
		}
	}
	reverse_proxy /chat-stream/* localhost:9000 {
		flush_interval -1
		transport http {
			read_timeout 30m
		}
	}

	# 其它 /admin /projects /repo /messages /health 等
	reverse_proxy localhost:9000

	# 安全 headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Headers "X-Admin-Token, Content-Type"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
	}

	log {
		output file /var/log/caddy/vibe-niuma.log
		format json
	}
}
